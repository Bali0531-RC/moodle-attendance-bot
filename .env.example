# AI Beállítások (GitHub Copilot Business / Pro alapértelmezetten bekapcsolva!)
# Ha új fiókkal akarsz belépni, írd be a futó bot termináljába: copilot-login

AI_PROVIDER=copilot
AI_MODEL=gpt-4o-mini

# Opcionális: Messenger automatikus visszaléptetés (ha a Facebook kidobná a sessiont) és 6-jegyű E2EE PIN kód:
FB_EMAIL=
FB_PASS=
MESSENGER_PIN=

# Ha saját külön OpenAI / Groq kulcsot akarnál használni Copilot helyett:
AI_API_KEY=
AI_BASE_URL=https://api.githubcopilot.com
